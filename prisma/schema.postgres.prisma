generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DataQuality {
  HIGH
  MEDIUM
  LOW
  UNKNOWN
}

enum DataSourceStatus {
  ACTIVE
  ERROR
  DEPRECATED
}

model City {
  id        String     @id @default(uuid())
  code      String     @unique // "chicago", "phoenix"
  name      String     // "Chicago CTA", "Phoenix Metro"
  stations  Station[]
}

model Station {
  id              String           @id @default(uuid())
  cityId          String
  externalId      String?          // GTFS stop_id or agency ID
  ctaStationId    String?          // CTA station number from Socrata (e.g., "41240")
  name            String
  latitude        Float
  longitude       Float
  lines           Json             // JSON array like '["Red", "Blue"]' for multi-line stations

  city            City             @relation(fields: [cityId], references: [id])
  aliases         StationAlias[]
  ridershipDaily  RidershipDaily[]
  metrics         StationMetrics?
  facts           StationFact[]
  narrative       StationNarrative?

  @@index([cityId, name])
  @@index([cityId, ctaStationId])
  @@unique([cityId, externalId])
}

model StationAlias {
  id              String   @id @default(uuid())
  stationId       String
  aliasName       String   // Alternative name from ridership data
  normalized      String   // Normalized version for matching

  station         Station  @relation(fields: [stationId], references: [id])

  @@index([normalized])
  @@unique([stationId, aliasName])
}

model RidershipDaily {
  id              String   @id @default(uuid())
  stationId       String
  serviceDate     DateTime
  entries         Int      // Total boardings for the day

  station         Station  @relation(fields: [stationId], references: [id])

  @@index([stationId, serviceDate])
  @@unique([stationId, serviceDate])
}

model StationMetrics {
  id              String   @id @default(uuid())
  stationId       String   @unique
  lastDayEntries  Int?     // Most recent day's ridership
  rolling30dAvg   Float?   // 30-day rolling average
  rolling90dAvg   Float?   // 90-day rolling average (optional)
  ghostScore      Int      // 0-100, higher = more "ghost"
  lastUpdated     DateTime
  serviceDateMax  DateTime // Latest data date
  dataStatus      String   @default("normal") // "normal" or "missing"

  station         Station  @relation(fields: [stationId], references: [id])
}

// ═══════════════════════════════════════════════════════════════
// FACTS + NARRATIVE SYSTEM
// Journalism-grade storytelling backed by cited facts
// ═══════════════════════════════════════════════════════════════

model DataSource {
  id             String        @id @default(uuid())
  code           String        @unique  // "cta_socrata", "census_acs_5yr", "census_decennial", "lodes", "fhwa"
  name           String        // "CTA L Station Entries Daily Totals"
  url            String        // Landing page URL
  apiUrl         String?       // Socrata API endpoint or Census API base
  datasetId      String?       // "5neh-572f" for Socrata
  license        String?       // "Public Domain", "CC BY 4.0", etc.
  lastFetched    DateTime?
  lastSuccessfulFetch DateTime?
  lastError      String?
  status         DataSourceStatus @default(ACTIVE)
  refreshCadence String?       // "daily", "annual", "static"

  facts          StationFact[]
}

model StationFact {
  id             String     @id @default(uuid())
  stationId      String
  factKey        String     // "ridership_2001_avg", "population_change"
  value          Float      // Percents stored as decimals: 0.52 = 52%
  valueType      String     // "number" | "percent" | "currency"
  unit           String     // "riders/day", "%", "lane-miles"
  geography      String     // "station", "walkshed_0.5mi", "region_il"
  timeframeStart Int?       // 2001, 2010, etc.
  timeframeEnd   Int?       // 2024, 2023, etc.
  methodology    String     // "Daily average for calendar year 2001"
  sourceId       String     // Primary source
  sourceNote     String?    // For multi-source facts: "Baseline: 2010 Decennial SF1 P001001"
  quality        DataQuality @default(UNKNOWN)
  qualityNote    String?
  evidenceMeta   Json?
  computedAt     DateTime   @default(now())

  station        Station    @relation(fields: [stationId], references: [id])
  source         DataSource @relation(fields: [sourceId], references: [id])

  @@unique([stationId, factKey])
  @@index([stationId])
}

model StationNarrative {
  id               String   @id @default(uuid())
  stationId        String   @unique
  archetypeKey     String   // "suburban_shift", "car_culture", "jobs_exodus"
  renderedStory    String   // Pre-rendered markdown
  evidenceFactKeys Json     // JSON array: '["ridership_2001_avg", "population_change"]'
  templateVersion  String   // "v1.0" - bump when template copy changes
  confidence       Float    // 0-1, how well facts match archetype
  quality          DataQuality @default(UNKNOWN)
  qualityNote      String?
  evidenceMeta     Json?
  lastComputed     DateTime @default(now())

  station          Station  @relation(fields: [stationId], references: [id])
}