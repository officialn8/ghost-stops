# Ghost Stops environment variables.
# Copy to .env.local (Next.js) or export them in your shell, then fill in values.
# Never commit real values: .env* is gitignored except this file, and CI runs gitleaks.
# Vercel holds these variables for Production and Preview.

# Neon Postgres, pooled host, used at runtime by the pg pool in src/lib/prisma.ts. Format:
# postgresql://<role>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# The connection timeout and pool size are set in src/lib/prisma.ts; pg ignores a connect_timeout here.
DATABASE_URL=

# Neon Postgres, direct host (same role and database, endpoint without "-pooler"), used by the
# Prisma CLI through prisma.config.ts.
# Schema migrations (prisma migrate deploy) run from an operator machine with the database
# owner role's direct URL. They never run in the Vercel build.
DATABASE_URL_UNPOOLED=

# Mapbox GL public access token (pk.*) for the map.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Socrata (Chicago Data Portal) app token. Sent only in the X-App-Token header, never logged.
CHICAGO_DATA_APP_TOKEN=

# Shared secret that Vercel Cron sends as a bearer token to the sync route.
CRON_SECRET=

# ── The live Ghost score worker (docs-private/runbooks/live-worker.md) ──────────────────────
# One key serves the worker and local runs; it travels in the query string, so no request URL
# is ever logged. Needed by the worker and by `scripts/live-worker.ts --once`.
CTA_TRAIN_TRACKER_KEY=

# Cloudflare R2: the bucket holding raw polls, the schedule archive, and the checkpoint.
# The worker's token is read-write and scoped to this one bucket; Vercel (Production only) holds
# a read-only token for the same bucket, which /api/health reads the checkpoint's age with.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The bearer secret the worker sends to POST /api/internal/revalidate after a nightly write.
# Generated with the fixed prefix ghrv_ so a gitleaks rule can match it; set on Fly and on
# Vercel (Production only). Never CRON_SECRET.
WORKER_REVALIDATE_SECRET=

# The site's origin the worker posts the revalidate call to (Fly only).
SITE_URL=https://ghost-stops.vercel.app

# Healthchecks.io ping URL for the dead-man's switch (Fly only); pinged after each successful
# poll cycle, posted to /fail on a quota stop or a revoked key.
HEALTHCHECKS_PING_URL=

# Optional: where the worker keeps part files and the feed download (default: the temp dir;
# /var/lib/ghost-stops in the image), and the machine id (Fly sets FLY_MACHINE_ID itself).
# LIVE_WORKER_DATA_DIR=
# FLY_MACHINE_ID=
